    },
    {
      "id": "65c9ff9fece842ec",
      "type": "text",
      "x": 73.75,
      "y": 1344.5,
      "width": 803.52,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "qJJr-5Oxw_fU5vt7ObTB3"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1606265294,
      "version": 24,
      "versionNonce": 1579006226,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789101160689,
      "link": null,
      "locked": false,
      "index": "a0224",
      "text": "• Rows are stored in pages in no particular order.\n• New rows are inserted into any page that has enough free space.\n• When a page is full, a new page (or extent) is allocated.\n• To find a row without an index, the database may need to scan pages one by one.\n• Updates may move a row if there is not enough space on the page.",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Rows are stored in pages in no particular order.\n• New rows are inserted into any page that has enough free space.\n• When a page is full, a new page (or extent) is allocated.\n• To find a row without an index, the database may need to scan pages one by one.\n• Updates may move a row if there is not enough space on the page.",
      "lineHeight": 1.25,
      "baseline": 96.8,
      "autoResize": true
    },
