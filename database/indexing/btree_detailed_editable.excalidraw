      "updated": 1789107864994,
      "link": null,
      "locked": false,
      "text": "Bậc minh họa: m = 4\n→ mỗi internal node tối đa 3 key, 4 child\n\nChuỗi key ví dụ:\n10, 20, 5, 6, 12, 30, 7, 17, 3, 8,\n15, 25, 40, 50, 60, 70",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 24,
      "containerId": null,
      "originalText": "Bậc minh họa: m = 4\n→ mỗi internal node tối đa 3 key, 4 child\n\nChuỗi key ví dụ:\n10, 20, 5, 6, 12, 30, 7, 17, 3, 8,\n15, 25, 40, 50, 60, 70",
      "lineHeight": 1.25,
      "autoResize": false
    },
