      "updated": 1789107864995,
      "link": null,
      "locked": false,
      "text": "ROOT / INTERNAL\nseparator keys + child page pointers\n\nLEAF\nsorted index keys + row references\nprev / next leaf links\n\nSEARCH\nRoot → Internal → Leaf → RowPtr\n\nRANGE\nSearch first key → NextLeaf → NextLeaf …\n\nROW REF\nchỉ là tham chiếu tới record thật,\nví dụ PageId + SlotId.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "baseline": 22,
      "containerId": null,
      "originalText": "ROOT / INTERNAL\nseparator keys + child page pointers\n\nLEAF\nsorted index keys + row references\nprev / next leaf links\n\nSEARCH\nRoot → Internal → Leaf → RowPtr\n\nRANGE\nSearch first key → NextLeaf → NextLeaf …\n\nROW REF\nchỉ là tham chiếu tới record thật,\nví dụ PageId + SlotId.",
      "lineHeight": 1.25,
      "autoResize": false
    },
