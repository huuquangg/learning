    {
      "id": "6b1aee529d214c28aa6c",
      "type": "text",
      "x": 40,
      "y": 95,
      "width": 390,
      "height": 250,
      "angle": 0,
      "strokeColor": "#111827",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": {
        "type": 3
      },
      "seed": 1,
      "version": 2,
      "versionNonce": 181215222,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789107864994,
      "link": null,
      "locked": false,
      "text": "• B+ Tree là cây cân bằng đa nhánh.\n• Mỗi node thường tương ứng một page.\n• Root / Internal node chỉ dùng key để định tuyến.\n• Leaf node chứa key + Row Pointer.\n• Tất cả leaf nằm ở cùng một level.\n• Leaf pages liên kết trái ↔ phải để range scan.\n• Nếu node có n key thì có n+1 child pointers.",
      "fontSize": 22,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 24,
      "containerId": null,
      "originalText": "• B+ Tree là cây cân bằng đa nhánh.\n• Mỗi node thường tương ứng một page.\n• Root / Internal node chỉ dùng key để định tuyến.\n• Leaf node chứa key + Row Pointer.\n• Tất cả leaf nằm ở cùng một level.\n• Leaf pages liên kết trái ↔ phải để range scan.\n• Nếu node có n key thì có n+1 child pointers.",
      "lineHeight": 1.25,
      "autoResize": false
    },
