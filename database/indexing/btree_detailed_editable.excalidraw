      "boundElements": [],
      "updated": 1789107864994,
      "link": null,
      "locked": false,
      "text": "1. Root P1: [20 | 40]\n   25 ≥ 20 và 25 < 40  → theo p2\n\n2. Internal P3: [30]\n   25 < 30  → theo p1\n\n3. Leaf P8: [17 | 20 | 25]\n   tìm thấy 25 → lấy Row Pointer\n   → truy cập record được tham chiếu.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 22,
      "containerId": null,
      "originalText": "1. Root P1: [20 | 40]\n   25 ≥ 20 và 25 < 40  → theo p2\n\n2. Internal P3: [30]\n   25 < 30  → theo p1\n\n3. Leaf P8: [17 | 20 | 25]\n   tìm thấy 25 → lấy Row Pointer\n   → truy cập record được tham chiếu.",
      "lineHeight": 1.25,
      "autoResize": false
    },
